# WorkBuddy 工作区元数据 / 会话记忆（本地状态，不纳入版本控制，不得删除）
# 如需纳入版本控制，请先征得同意再移除本行，并单独提交说明
.workbuddy/

# 编辑器与操作系统
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 临时与构建产物
*.tmp
*.temp
*.log
*.out
.tmp_*
dist/
build/
coverage/
node_modules/
__pycache__/
*.pyc
*.tsbuildinfo

# 语言 / 工具缓存与虚拟环境
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.cache/
.next/
.venv/
venv/

# 备份与冲突残留（防止提交前顺手带上）
*.bak
*.orig
*.rej
*~

# 密钥、证书与本地配置（严禁提交）
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*_keyring
credentials.local.*
secrets/

# 部署机密：secrets 只允许出现在 deploy/passwords.yml（ADR-17），该文件永不入库
deploy/passwords.yml
passwords.yml
*.vault

# 离线制品与压缩包（走制品库，不进 git）
*.tar
*.tar.gz
*.tgz
*.zip
offline-images-*
platform-bundle-*

# 离线制品库（ADR-15 内网源）：随代码入库，供现场无外网时使用
# 注意：这里只放公开发行包（RPM/wheel/官方二进制），严禁放私钥、证书、客户数据
!deploy/artifacts/
!deploy/artifacts/**

# Go 构建产物（交付时只传编译好的单二进制，产物不入库）
/server/bin/
/server/winter-server
/server/winter-server.exe
*.test
*.test.exe
# vendor 只用于离线的开发验证，正式交付是单二进制，不入库
/server/vendor/
