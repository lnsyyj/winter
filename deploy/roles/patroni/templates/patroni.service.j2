[Unit]
Description=Patroni (winter PostgreSQL HA)
Documentation=https://patroni.readthedocs.io/
After=network-online.target etcd.service
Wants=network-online.target etcd.service

[Service]
Type=simple
User=postgres
Group=postgres
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/pgsql-{{ patroni.pg_major }}/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/patroni /etc/patroni/patroni.yml
# Patroni manages the PG process itself; do not use KillMode=control-group here, otherwise a restart takes PG down with it
KillMode=process
TimeoutSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
