# {{ ansible_managed | default('managed by ansible') }}
[Unit]
Description=Winter LVS/DR loopback VIP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ lvs_realserver.helper }} add
ExecStop={{ lvs_realserver.helper }} del
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
