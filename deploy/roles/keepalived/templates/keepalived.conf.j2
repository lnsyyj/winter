# {{ ansible_managed | default('managed by ansible') }}
# Generated by deploy/roles/keepalived; do not edit by hand.
# VRRP fronts the access layer. With LVS/DR enabled the VIP dispatches connections across
# every [nginx_nodes] backend instead of sitting idle on whichever node holds it.

global_defs {
    router_id winter-{{ inventory_hostname }}
    enable_script_security
    script_user root
}

{% if ha.lvs.enabled | default(false) | bool %}
vrrp_script chk_lvs {
    script "{{ keepalived_lvs_check_script }}"
    interval {{ ha.nginx_check_interval }}
    timeout 2
    rise 2
    fall 3
}
{% else %}
vrrp_script chk_nginx {
    script "{{ keepalived_check_script }}"
    interval {{ ha.nginx_check_interval }}
    timeout 2
    rise 2
    fall 3
}
{% endif %}

vrrp_instance WINTER {
    state {{ ha.state | default('BACKUP') }}
    interface {{ ha.interface }}
    virtual_router_id {{ ha.virtual_router_id }}
    priority {{ ha.priority }}
    advert_int {{ ha.advertise_interval }}
    preempt {% if ha.preempt | default(true) %}true{% else %}false{% endif %}

    authentication {
        auth_type {{ ha.auth_type }}
        auth_pass {{ vault_keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ ha.vip }}
    }

    track_script {
{% if ha.lvs.enabled | default(false) | bool %}
        chk_lvs
{% else %}
        chk_nginx
{% endif %}
    }
{% set peers = ha_peer_addresses | default(ha.peer_addresses | default([])) %}
{% if peers | length > 0 %}
    unicast_peer {
{% for peer in peers %}
        {{ peer }}
{% endfor %}
    }
{% endif %}
}
{% if ha.lvs.enabled | default(false) | bool %}

# LVS/DR: connections to the VIP are scheduled across every real Nginx backend.
# Real servers answer with the VIP as source address, so return traffic bypasses
# this Director; the matching VIP/ARP setup is done by roles/realserver.
virtual_server {{ ha.vip }} {{ ha.lvs.real_server_port }} {
    delay_loop {{ ha.lvs.health_interval }}
    lb_algo {{ ha.lvs.scheduler }}
    lb_kind DR
    persistence_timeout {{ ha.lvs.persistence_timeout }}
    protocol TCP

{% for rs in ha.lvs.real_servers | default([]) %}
    real_server {{ rs }} {{ ha.lvs.real_server_port }} {
        weight 1
        TCP_CHECK {
            connect_timeout {{ ha.lvs.connect_timeout }}
            connect_port {{ ha.lvs.real_server_port }}
        }
    }
{% endfor %}
}
{% endif %}
