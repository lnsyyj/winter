#!/usr/bin/env bash
# {{ ansible_managed | default('managed by ansible') }}
# Exit 0 only when Nginx is running and its HTTPS health endpoint answers.
set -u

if ! pgrep -x nginx >/dev/null 2>&1; then
    exit 1
fi

# Use platform.* (always loaded from group_vars) instead of the nginx role-local dict,
# so this script also renders when the keepalived stage runs without the nginx role.
if ! curl -ksS --max-time 2 -H "Host: {{ platform.domain }}" \
    "https://127.0.0.1:{{ platform.https_port }}/healthz" >/dev/null 2>&1; then
    exit 1
fi

exit 0
