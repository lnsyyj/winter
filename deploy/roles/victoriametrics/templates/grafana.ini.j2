# {{ ansible_managed | default('managed by ansible') }}
# Grafana listens only on localhost; all external access goes through the Nginx /grafana/ reverse proxy (ADR-09),
# direct access to the dashboard bypassing platform RBAC is forbidden (B9).
[server]
http_addr = {{ victoriametrics.listen_addr }}
http_port = {{ victoriametrics.components.grafana.port }}
root_url = https://{{ platform.domain }}/grafana/
serve_from_sub_path = true

[security]
admin_user = {{ winter_server.admin_user }}
admin_password = {{ vault_grafana_admin_password }}
disable_gravatar = true

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

[paths]
data = {{ victoriametrics.data_dir }}/grafana
logs = {{ victoriametrics.data_dir }}/grafana/log
provisioning = {{ victoriametrics.config_dir }}/grafana/provisioning

[log]
mode = console
level = info
