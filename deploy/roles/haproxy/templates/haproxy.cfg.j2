# {{ ansible_managed | default('managed by ansible') }}
#
# Generated by deploy/roles/haproxy, do not edit manually.
# Exposes a single write entry point, always pointing to the current primary (determined via Patroni REST /primary).

global
    maxconn 1000
    log stdout format raw local0
    stats socket /var/run/haproxy.sock mode 600 level admin

defaults
    mode tcp
    log global
    timeout connect 3s
    timeout client  30m
    timeout server  30m

# Write entry point: applications connect here
frontend winter_pg
    bind *:{{ pg_cluster.haproxy.listen_port }}
    default_backend winter_pg_primary

backend winter_pg_primary
    option httpchk GET /primary
    http-check expect status 200
    default-server inter {{ pg_cluster.haproxy.check_interval }} fall {{ pg_cluster.haproxy.check_fall }} rise {{ pg_cluster.haproxy.check_rise }}
{% for h in groups['management'] %}
    server {{ h }} {{ hostvars[h]['ansible_host'] }}:{{ pg_cluster.port }} check port {{ pg_cluster.rest_port }}
{% endfor %}

# Optional: read-only entry point (pointing to replicas), not currently used, kept for future expansion
# backend winter_pg_replica
#     option httpchk GET /replica
#     http-check expect status 200
#     server ... same as above
