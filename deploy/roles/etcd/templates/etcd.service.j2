[Unit]
Description=etcd (winter Patroni DCS)
Documentation=https://etcd.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
# 不用 Type=notify：官方 etcd 二进制不发 sd_notify，systemd 会一直等到超时判失败
# （进程其实已经正常起来）。Type=exec 只等 exec 成功即可。
Type=exec
User=root
# 数据目录独立；与 PG 无关
ExecStart={{ etcd_role.bin_dir }}/etcd \
  --name {{ inventory_hostname }} \
  --data-dir {{ pg_cluster.etcd.data_dir }} \
  --listen-client-urls http://{{ ansible_host }}:{{ pg_cluster.etcd.client_port }},http://127.0.0.1:{{ pg_cluster.etcd.client_port }} \
  --advertise-client-urls http://{{ ansible_host }}:{{ pg_cluster.etcd.client_port }} \
  --listen-peer-urls http://{{ ansible_host }}:{{ pg_cluster.etcd.peer_port }} \
  --initial-advertise-peer-urls http://{{ ansible_host }}:{{ pg_cluster.etcd.peer_port }} \
  --initial-cluster {% for h in groups['management'] %}{{ h }}=http://{{ hostvars[h]['ansible_host'] }}:{{ pg_cluster.etcd.peer_port }}{% if not loop.last %},{% endif %}{% endfor %} \
  --initial-cluster-token winter-etcd \
  --initial-cluster-state new \
  --heartbeat-interval 1000 \
  --election-timeout 5000
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
