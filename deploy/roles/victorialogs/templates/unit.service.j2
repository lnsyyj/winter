# {{ ansible_managed | default('managed by ansible') }}
# Winter victoriametrics component: {{ comp_key }}
# Generated by deploy/roles/victoriametrics; do not edit by hand.
# Ports and command-line arguments all come from victoriametrics.components in group_vars/all.yml.
# Cross-node overrides (bind address, vmalert notifier list, Alertmanager gossip peers) are
# computed by the monitoring scale playbooks; single-node runs keep the localhost defaults.

{% set bind_addr = victoriametrics_bind_addr | default(victoriametrics.listen_addr) %}
{% set effective_args = comp.args %}
{% set ns = namespace(cluster_args='') %}
{% if comp_key == 'alertmanager' and (monitor_peers | default([]) | length) > 1 %}
{% set ns.cluster_args = '--cluster.listen-address=' ~ (victoriametrics_advertise_addr | default(victoriametrics.listen_addr)) ~ ':' ~ (victoriametrics_scale.cluster_port | default(9094)) %}
{% for peer in monitor_peers %}
{% set ns.cluster_args = ns.cluster_args ~ ' --cluster.peer=' ~ peer ~ ':' ~ (victoriametrics_scale.cluster_port | default(9094)) %}
{% endfor %}
{% endif %}

[Unit]
Description=Winter victoriametrics: {{ comp_key }}
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User={{ victoriametrics.run_user }}
Group={{ victoriametrics.run_user }}
{% if comp.mode | default('binary') == 'directory' %}
WorkingDirectory={{ comp.install_dir }}
Environment=HOME={{ victoriametrics.data_dir }}/grafana
Environment=GF_SERVER_HTTP_ADDR={{ bind_addr }}
Environment=GF_SERVER_HTTP_PORT={{ comp.port }}
Environment=GF_SERVER_ROOT_URL=https://{{ platform.domain }}/grafana/
Environment=GF_SERVER_SERVE_FROM_SUB_PATH=true
Environment=GF_PATHS_DATA={{ victoriametrics.data_dir }}/grafana
Environment=GF_PATHS_LOGS={{ victoriametrics.data_dir }}/grafana/log
Environment=GF_PATHS_PROVISIONING={{ victoriametrics.config_dir }}/grafana/provisioning
ExecStart={{ comp.install_dir }}/bin/grafana server --homepath={{ comp.install_dir }} --config={{ victoriametrics.config_dir }}/grafana.ini
{% else %}
ExecStart={{ victoriametrics.bin_dir }}/{{ comp.binary }} {{ effective_args }}{% if comp_key == 'vmalert' %}{% for notifier in victoriametrics_vmalert_notifiers | default([]) %} -notifier.url=http://{{ notifier }}:{{ victoriametrics_ports.alertmanager }}{% endfor %}{% endif %} {{ comp.listen_flag }}={{ bind_addr }}:{{ comp.port }}{% if ns.cluster_args %} {{ ns.cluster_args }}{% endif %}{% endif %}{{ '\n' }}
Restart=always
RestartSec=5s
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
