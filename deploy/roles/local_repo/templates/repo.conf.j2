# {{ ansible_managed | default('managed by ansible') }}
#
# Local artifact repository (read-only). Generated by deploy/roles/local_repo; do not edit by hand.
# Plaintext HTTP: nodes only need connectivity, no need to trust a self-signed CA; the source subnet is restricted by the firewall.

server {
    listen      {{ local_repo.listen_port }};
    server_name _;

    root  {{ local_repo.root }};
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    access_log off;
    error_log  /var/log/nginx/winter-repo.error.log warn;

    location / {
        # Read-only (limit_except may only appear inside a location)
        limit_except GET { deny all; }
        try_files $uri $uri/ =404;
    }
}
