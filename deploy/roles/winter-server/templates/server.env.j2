# {{ ansible_managed | default('managed by ansible') }}
# 生成物，请勿手改；权限 0640，含数据库口令与 JWT 密钥。
# 改配置请改 group_vars/all.yml 与 passwords.yml，然后重跑 deploy.sh server。
#
# 注意：口令中的 @ / : / ? / # 等字符需要 URL 编码，否则 DATABASE_URL 解析会出错。
DATABASE_URL=postgres://{{ postgresql_overrides.db_user | default('winter') }}:{{ vault_pg_password }}@127.0.0.1:{{ pg_cluster.haproxy.listen_port }}/{{ postgresql_overrides.db_name | default('winter') }}?sslmode=disable
AUDIT_DATABASE_URL=postgres://{{ postgresql_overrides.db_user | default('winter') }}:{{ vault_pg_password }}@127.0.0.1:{{ pg_cluster.haproxy.listen_port }}/{{ postgresql_overrides.db_name | default('winter') }}?sslmode=disable
JWT_SECRET={{ vault_jwt_secret }}
ADMIN_USER={{ winter_server.admin_user }}
ADMIN_PASSWORD={{ vault_admin_password }}
LISTEN_ADDR={{ winter_server.listen_addr }}:{{ winter_server.port }}
APP_ENV={{ winter_server.app_env }}
