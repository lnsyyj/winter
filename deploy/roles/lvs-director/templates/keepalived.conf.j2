# {{ ansible_managed | default('managed by ansible') }}
# Generated by deploy/roles/keepalived; do not edit by hand.
# One VRRP instance per VIP. With multiple VIPs each Director owns one as MASTER and backs up
# the others (active-active), so no Director is idle. With LVS/DR each VIP dispatches across
# every [nginx] backend and real servers answer directly, bypassing the Director.

{% if ha.vips | default([]) | length > 0 %}
{% set vips = ha.vips %}
{% else %}
{% set vips = [ha.vip] %}
{% endif %}
{% set lb_nodes = lvs_directors | default([inventory_hostname]) %}
{% set lb_count = lb_nodes | length if lb_nodes | length > 0 else 1 %}
{% set node_index = lb_nodes.index(ansible_host) if ansible_host in lb_nodes else 0 %}
{% set lvs_on = ha.lvs.enabled | default(false) | bool %}

global_defs {
    router_id winter-{{ inventory_hostname }}
    enable_script_security
    script_user root
}

{% if lvs_on %}
vrrp_script chk_lvs {
    script "{{ keepalived_lvs_check_script }}"
    interval {{ ha.nginx_check_interval }}
    timeout 2
    rise 2
    fall 3
}
{% else %}
vrrp_script chk_nginx {
    script "{{ keepalived_check_script }}"
    interval {{ ha.nginx_check_interval }}
    timeout 2
    rise 2
    fall 3
}
{% endif %}

{% for vip in vips %}
{% set master_index = loop.index0 % lb_count %}
vrrp_instance WINTER_{{ loop.index }} {
    state BACKUP
    interface {{ ha.interface }}
    virtual_router_id {{ (ha.virtual_router_id | int) + loop.index0 }}
    priority {{ (ha.priority | int) if node_index == master_index else ((ha.priority | int) - 10) }}
    advert_int {{ ha.advertise_interval }}
    preempt {% if ha.preempt | default(true) %}true{% else %}false{% endif %}

    authentication {
        auth_type {{ ha.auth_type }}
        auth_pass {{ vault_keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ vip }}
    }

    track_script {
{% if lvs_on %}
        chk_lvs
{% else %}
        chk_nginx
{% endif %}
    }
{% set peers = ha_peer_addresses | default(ha.peer_addresses | default([])) %}
{% if peers | length > 0 %}
    unicast_peer {
{% for peer in peers %}
        {{ peer }}
{% endfor %}
    }
{% endif %}
}
{% endfor %}
{% if lvs_on %}

{% for vip in vips %}
# LVS/DR for VIP {{ vip }}: connections are scheduled across every real Nginx backend.
virtual_server {{ vip }} {{ ha.lvs.real_server_port }} {
    delay_loop {{ ha.lvs.health_interval }}
    lb_algo {{ ha.lvs.scheduler }}
    lb_kind DR
    persistence_timeout {{ ha.lvs.persistence_timeout }}
    protocol TCP

{% for rs in ha.lvs.real_servers | default([]) %}
    real_server {{ rs }} {{ ha.lvs.real_server_port }} {
        weight 1
        TCP_CHECK {
            connect_timeout {{ ha.lvs.connect_timeout }}
            connect_port {{ ha.lvs.real_server_port }}
        }
    }
{% endfor %}
}
{% endfor %}
{% endif %}
