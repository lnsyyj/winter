# {{ ansible_managed | default('managed by ansible') }}
# Generated by deploy/roles/harbor; do not edit by hand.
# All replicas share external PostgreSQL, external Redis and an NFS-backed data volume (ADR-16).

hostname: {{ harbor.hostname }}

http:
  port: {{ harbor.http_port }}

data_volume: {{ harbor.storage.mount_point }}

external_database:
  harbor:
    host: {{ harbor.database.host }}
    port: {{ harbor.database.port }}
    db_name: {{ harbor.database.name }}
    username: {{ harbor.database.user }}
    password: {{ vault_harbor_db_password }}
    ssl_mode: disable

external_redis:
  host: {{ harbor.redis.host }}
  port: {{ harbor.redis.port }}
  password: {{ vault_harbor_redis_password }}
  database: {{ harbor.redis.db }}

harbor_admin_password: {{ vault_harbor_admin_password }}

log:
  level: info
  rotate_count: 50
  rotate_size: 200M
  location: /var/log/harbor
