# {{ ansible_managed | default('managed by ansible') }}
# Generated by deploy/roles/harbor; do not edit by hand.
# ADR-16: builtin mode uses Harbor's bundled PostgreSQL/Redis and a local data volume (MVP single
# node). external mode points at a shared external PostgreSQL, Redis and NFS volume (V1 HA).

hostname: {{ harbor.hostname }}

http:
  port: {{ harbor.http_port }}

{% if (harbor.mode | default('builtin')) == 'builtin' %}
# Builtin mode: no external_database / external_redis sections. Harbor's prepare script starts
# its own bundled PostgreSQL and Redis containers and stores data on the local volume below.
data_volume: {{ harbor.local_volume | default(harbor.data_dir + '/data') }}
{% else %}
# External mode: all replicas share external PostgreSQL, Redis and an NFS-backed data volume.
data_volume: {{ harbor.storage.mount_point }}

external_database:
  harbor:
    host: {{ harbor.database.host }}
    port: {{ harbor.database.port }}
    db_name: {{ harbor.database.name }}
    username: {{ harbor.database.user }}
    password: {{ vault_harbor_db_password }}
    ssl_mode: disable

external_redis:
  host: {{ harbor.redis.host }}
  port: {{ harbor.redis.port }}
  password: {{ vault_harbor_redis_password }}
  database: {{ harbor.redis.db }}
{% endif %}

harbor_admin_password: {{ vault_harbor_admin_password }}

log:
  level: info
  rotate_count: 50
  rotate_size: 200M
  location: /var/log/harbor
