# {{ ansible_managed | default('managed by ansible') }}
# Grafana 只监听本机，对外统一走 Nginx /grafana/ 反代（ADR-09），
# 禁止绕过平台 RBAC 直连面板（B9）。
[server]
http_addr = {{ observability.listen_addr }}
http_port = {{ observability.components.grafana.port }}
root_url = https://{{ platform.domain }}/grafana/
serve_from_sub_path = true

[security]
admin_user = {{ winter_server.admin_user }}
admin_password = {{ vault_grafana_admin_password }}
disable_gravatar = true

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

[paths]
data = {{ observability.data_dir }}/grafana
logs = {{ observability.data_dir }}/grafana/log
provisioning = {{ observability.config_dir }}/grafana/provisioning

[log]
mode = console
level = info
