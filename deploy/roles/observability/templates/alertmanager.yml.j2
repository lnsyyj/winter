# {{ ansible_managed | default('managed by ansible') }}
# The single alert egress (ADR-18): vmalert → Alertmanager → webhook feeds back to the platform (ADR-33).
# At M0 the Server's HMAC webhook endpoint is not yet implemented; this is a placeholder for now;
# alerts may be dropped, audit must not be; endpoint unavailability does not affect job execution.
global:
  resolve_timeout: 5m

route:
  receiver: winter-webhook
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: winter-webhook
    webhook_configs:
      - url: http://{{ monitoring_server_url | default(observability.listen_addr) }}:{{ winter_server.port }}/v1/alerts/webhook
        send_resolved: true
        max_alerts: 20

inhibit_rules:
  - source_matchers: [severity="critical"]
    target_matchers: [severity="warning"]
    equal: [alertname, cluster]
