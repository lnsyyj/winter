# {{ ansible_managed | default('managed by ansible') }}
# Ready to use out of the box: a default datasource pointing to the local VictoriaMetrics is installed (ADR-18)
apiVersion: 1
datasources:
  - name: VictoriaMetrics
    type: prometheus
    access: proxy
    url: http://{{ observability.listen_addr }}:{{ observability.components.victoriametrics.port }}
    isDefault: true
    editable: false
