# {{ ansible_managed | default('managed by ansible') }}
#
# This file is generated by deploy/roles/nginx; do not edit by hand.
# Design constraint: do not modify nginx.conf, do not declare default_server — existing sites on the same port are unaffected.
#
# Grafana can run on multiple monitor nodes. The scale playbooks publish the replica addresses
# as monitor_grafana_upstreams; single-node runs keep the original localhost proxy_pass.
{% if monitor_grafana_upstreams | default([]) | length > 0 %}
upstream winter_grafana {
{% for upstream in monitor_grafana_upstreams %}
    server {{ upstream }}:{{ monitoring_ports.grafana }} max_fails=3 fail_timeout=10s;
{% endfor %}
    keepalive 16;
}
{% set winter_grafana_target = 'http://winter_grafana' %}
{% else %}
{% set winter_grafana_target = 'http://' ~ monitoring_listen_addr ~ ':' ~ (monitoring_ports.grafana | string) %}
{% endif %}

server {
    listen      {{ nginx.http_port }};
    listen      [::]:{{ nginx.http_port }};
    server_name {{ nginx.server_name }};

    # Redirect everything to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen      {{ nginx.https_port }} ssl;
    listen      [::]:{{ nginx.https_port }} ssl;
    server_name {{ nginx.server_name }};

    ssl_certificate     {{ nginx.tls_dir }}/server.crt;
    ssl_certificate_key {{ nginx.tls_dir }}/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:winter_tls:10m;
    ssl_session_timeout 10m;

    # Do not let credentials enter intermediate caches
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    root  {{ nginx.doc_root }};
    index index.html;

    # Health check: disable access log to avoid flooding
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain always;
        return 200 "ok\n";
    }

    # Management plane API (effective once the Server is up; returns 502 before then, expected)
    location /api/ {
        proxy_pass         {{ nginx.api_upstream }}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Grafana: always enter via the platform domain; direct access to port 3000 bypassing platform RBAC is forbidden (ADR-09)
    # Port comes from group_vars' monitoring_ports.grafana, not hardcoded in this template
    location /grafana/ {
        proxy_pass         {{ winter_grafana_target }}/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # WebSocket (task progress push)
    location /ws {
        proxy_pass         {{ nginx.api_upstream }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 3600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
