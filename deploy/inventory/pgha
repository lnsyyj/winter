# Three-node high availability topology (Patroni + etcd), corresponding to the PG distributed HA after ADR-38 was withdrawn
#
# Usage:
#   ./deploy.sh deploy -i inventory/pgha --tags repo             publish the internal repo only on pg-c
#   ./deploy.sh deploy -i inventory/pgha --tags postgresql       install PG on all three (PGDG unreachable, use the internal repo)
#
# Port convention (avoid port 5432, already used by argus on pg-c):
#   PG 5433 / Patroni REST 8008 / etcd 2379,2380

[management]
pg-a ansible_host=192.168.101.197
pg-b ansible_host=192.168.101.198
pg-c ansible_host=192.168.101.194 patroni_disable_standalone=false   # port 5432 on this host is used by argus, so the system instance must be preserved

[pg_primary_candidate]
pg-a

[pg_repo]
pg-c

[observability:children]
management

# HA roles default to the PG nodes; move them to dedicated hosts for HA.
[keepalived:children]
management

[winter-server:children]
management

[harbor:children]
management

# Real Nginx backends for LVS/DR; split from [keepalived] for multi-active load balancing.
[nginx:children]
management

# Component groups for independent deployment (one single-component stage per group).
[local-repo:children]
management

[postgresql:children]
management

[named:children]
management

# System initialization runs on every host (management and managed nodes).
[system-init:children]
management
agent

[agent]

[all:vars]
ansible_user=root
ansible_python_interpreter=/usr/bin/python3
