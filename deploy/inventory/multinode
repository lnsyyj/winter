# Multi-node (site topology). Group semantics: management=management plane, ceph_nodes=managed nodes, monitor=observability
#
# Conventions:
# - Do not test hostnames in playbooks; always express topology with groups (ADR-17 / I16)
# - Prefer IPs for ansible_host; domain names are only for certificates and registry, see group_vars/prechecks.required_hosts

[management]
mgr01 ansible_host=10.0.0.11

[monitor:children]
management

# HA roles default to the management node; move them to dedicated hosts for HA.
[lb:children]
management

[server_nodes:children]
management

[harbor_nodes:children]
management

# Real Nginx backends for LVS/DR; split from [lb] for multi-active load balancing.
[nginx_nodes:children]
management

# Component groups for independent deployment (one single-component stage per group).
[repo_nodes:children]
management

[db_nodes:children]
management

[dns_nodes:children]
management

# System initialization runs on every host (management and managed nodes).
[system_init_nodes:children]
management
ceph_nodes

[ceph_nodes]
node01 ansible_host=10.0.0.21
node02 ansible_host=10.0.0.22
node03 ansible_host=10.0.0.23

[all:vars]
ansible_user=root
ansible_python_interpreter=/usr/bin/python3
# If switching to a normal account + sudo, declare it explicitly instead of relying on defaults:
#ansible_become=true
#ansible_become_method=sudo
