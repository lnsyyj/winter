# Single machine (M0 first runs through locally, corresponds to kolla-ansible's all-in-one)
# Usage: ./deploy.sh prechecks            (this file is used by default when -i is not passed)

[management]
localhost ansible_connection=local ansible_host=127.0.0.1

[observability:children]
management

# HA roles default to the same node until the topology is split.
[keepalived:children]
management

[winter-server:children]
management

[harbor:children]
management

# Real Nginx backends for LVS/DR; split from [keepalived] for multi-active load balancing.
[nginx:children]
management

# Component groups for independent deployment (one single-component stage per group).
[local-repo:children]
management

[postgresql:children]
management

[named:children]
management

# System initialization runs on every host (management and managed nodes).
[system-init:children]
management

[agent]

[all:vars]
ansible_python_interpreter=/usr/bin/python3
