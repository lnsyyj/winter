# Single machine (M0 first runs through locally, corresponds to kolla-ansible's all-in-one)
# Usage: ./deploy.sh prechecks            (this file is used by default when -i is not passed)

[management]
localhost ansible_connection=local ansible_host=127.0.0.1

[monitor:children]
management

# HA roles default to the same node until the topology is split.
[lb:children]
management

[server_nodes:children]
management

[harbor_nodes:children]
management

# Real Nginx backends for LVS/DR; split from [lb] for multi-active load balancing.
[nginx_nodes:children]
management

[ceph_nodes]

[all:vars]
ansible_python_interpreter=/usr/bin/python3
