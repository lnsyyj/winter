---
# 复制为 deploy/passwords.yml（已在 .gitignore 中排除，绝不入库），按现场替换全部值。
# ansible 的 pre_tasks 会 include_vars 这个文件；缺失的键由各 role 显式 assert 拦截。
vault_pg_password: "CHANGE_ME_PG_PASSWORD"
# JWT_SECRET 至少 32 字符；换掉它会使所有已签发的 access token 立即失效
vault_jwt_secret: "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"
# break-glass 本地管理员（ADR-34），只在首次启动时创建，不覆盖已有口令
vault_admin_password: "CHANGE_ME_ADMIN_PASSWORD"
# Grafana 面板管理员；面板只经 Nginx /grafana/ 反代暴露（ADR-09）
vault_grafana_admin_password: "CHANGE_ME_GRAFANA_PASSWORD"
