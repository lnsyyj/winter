---
# Copy to deploy/passwords.yml (excluded by .gitignore, never committed) and replace all values for the site.
# Ansible's pre_tasks will include_vars this file; missing keys are caught by explicit asserts in each role.
vault_pg_password: "CHANGE_ME_PG_PASSWORD"
# JWT_SECRET must be at least 32 characters; changing it immediately invalidates all issued access tokens
vault_jwt_secret: "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"
# break-glass local administrator (ADR-34), created only on first startup and does not overwrite an existing password
vault_admin_password: "CHANGE_ME_ADMIN_PASSWORD"
# Grafana dashboard administrator; the dashboard is exposed only through the Nginx /grafana/ reverse proxy (ADR-09)
vault_grafana_admin_password: "CHANGE_ME_GRAFANA_PASSWORD"
# VRRP authentication password (max 8 characters); shared by all [keepalived] nodes
vault_keepalived_auth_pass: "VRRPPASS"
# External database / Redis credentials used by Harbor replicas
vault_harbor_db_password: "CHANGE_ME_HARBOR_DB_PASSWORD"
vault_harbor_redis_password: "CHANGE_ME_HARBOR_REDIS_PASSWORD"
vault_harbor_admin_password: "CHANGE_ME_HARBOR_ADMIN_PASSWORD"
# BIND 9 master/slave TSIG key, base64-encoded HMAC-SHA256 (generate with: openssl rand -base64 32)
vault_dns_tsig_secret: "CHANGE_ME_BASE64_TSIG_SECRET"
