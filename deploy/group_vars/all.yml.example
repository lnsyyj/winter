# Single configuration entry point (ADR-17 §2.1 / ADR-45).
#
# This is the ONLY config + secret file. It is gitignored: copy all.yml.example to all.yml
# and fill in the vault_* values. Never commit this file.
#
# Rules:
# - All variable configuration AND secrets go here; no hardcoding in playbooks/roles
# - Roles carry no defaults/main.yml; every tunable is consolidated in this file
# - group_vars/all.yml is auto-loaded by Ansible, so no play needs to include it twice
# - After changing this file, rerun the relevant stage (reconfigure / deploy converge to the new state)
#
# Naming (ADR-50): every config key is prefixed with the SOFTWARE NAME of the role/operation
# that owns it. `victoriametrics_*` -> roles/victoriametrics, `winter_server_*` -> roles/winter-server.
# No concept names (monitoring/obs/server/agent/repo/system_init) remain.
#
# Config ownership index (key -> role / operation), ordered as site.yml plays:
#   platform.*, prechecks.*       system-checks / global    (hosts: all, plays 1 / prechecks)
#   os_init*, os_init.*           os-init role              (play: OS initialization)
#   bootstrap*, bootstrap.*       bootstrap role            (play: Base dependencies, hosts: all)
#   repo_nginx*, repo_nginx.*     repo-nginx role           (play: Nginx artifact repository)
#   etcd*, etcd.*                 etcd role                 (play: etcd cluster)
#   postgresql*, pg_cluster*,     postgresql role           (play: PostgreSQL single instance / HA /
#   pg_scale*, pg_migrate*        postgresql-scale-* / postgresql-migrate)
#   patroni.*, haproxy.*         patroni / haproxy roles   (via postgresql-ha)
#   nginx*, nginx.*               nginx role                (play: Nginx access layer / application-ha)
#   victoriametrics*              victoriametrics role      (play: VictoriaMetrics stack / *-scale-*)
#   winter_server*, winter_server.*  winter-server role     (play: Management Server / application-ha)
#   harbor*, harbor.*             harbor role               (play: Harbor registry)
#   keepalived.*, ha*, ha.*       keepalived role           (play: Keepalived / application-ha)
#   lvs_realserver.*              lvs-realserver role       (operations: LVS real servers)
#   named*, named.*               named role (BIND 9)       (play: BIND 9 DNS)
#   winter_agent*, winter_agent.* winter-agent role         (play: winter-agent pre-install)
#   upgrade.* / reconfigure       upgrade / reconfigure operations
#   uninstall*, uninstall.*       uninstall role            (operations: destroy)
#   vault_*                       secrets consumed by whichever role needs them
platform:
  # Platform external domain name (certificates and access entry point)
  domain: winter.local
  # Management plane API listen port (the only externally open port, see deployment plan §2)
  https_port: 443

  # Internal software repo (ADR-15): provided by Nginx on the management node (published by roles/repo-nginx)
  # When the site has no internet access, all RPMs / wheels / binaries are fetched from here.
  # Derived from the first [repo-nginx] host so it follows the environment instead of a hardcoded site IP;
  # override platform.repo_base_url in a site-specific vars file if the repo is published elsewhere.
  repo_base_url: "http://{{ hostvars[groups['repo-nginx'][0]]['ansible_host'] | default(hostvars[groups['repo-nginx'][0]]['inventory_hostname']) }}:{{ repo_nginx_listen_port }}"

  # Image registry (ADR-16): self-hosted Harbor, all images are pulled through it
  registry_host: ""
  registry_ca_path: ""

  # Data directory: data volumes and offline packages are stored separately to avoid being cleaned up during upgrades
  data_dir: /var/lib/winter

  # Authentication (ADR-22): local accounts enabled by default; if the customer has a directory service, fill in ldap and set enabled: true
  # Constraints: TLS required; any group not matched by role_map has no permissions (default_role: none);
  #             the local administrator is always kept (break-glass); a directory service outage does not affect their login
  auth:
    providers: [local, ldap]
    # Sessions (ADR-34): short access, long refresh; cache_ttl determines the eviction delay (0 = immediate but queries the DB on every request)
    session:
      access_ttl_minutes: 15
      refresh_ttl_days: 7
      cache_ttl_seconds: 30
    ldap:
      enabled: false
      url: ""                          # e.g.: ldaps://dc01.corp.local:636
      starttls: false                  # must be true when url is ldap://
      tls_verify: true
      bind_dn: ""                      # service account used for searches; password goes in group_vars/all.yml (vault_ldap_bind_password)
      base_dn: ""                      # e.g.: ou=people,dc=corp,dc=local
      # Placeholders {login} / {user_dn} are substituted by the platform at login time; they are **not Ansible variables** (do not write them as {{ }})
      user_filter: "(sAMAccountName={login})"
      group_base_dn: ""
      group_filter: "(member={user_dn})"
      role_map: {}                     # LDAP group DN -> platform role, e.g. {"CN=ceph-admins,OU=groups,DC=corp,DC=local": admin}
      default_role: none               # no matching mapping = no permissions
      timeout_seconds: 5
      group_cache_ttl_seconds: 300

  # Data retention (ADR-32): configurable, but 180 days for audits is a hard floor (the platform refuses to start below it)
  # Three reference profiles: minimal 7/15/30/180 · standard 30/30/90/180 · long-retention 90/90/365/730
  # Before increasing, check the capacity estimate printed by reconfigure, or the disk will fill up in a few months
  retention:
    logs_days: 30
    metrics_days: 30
    tasks_days: 90
    audit_online_days: 180
    sessions_days: 7

# Precheck thresholds (aligned with the resource estimates in deployment plan §1; Harbor and the victoriametrics stack dominate)
# All thresholds below are configurable: tune them to the target host and set strict_* switches to false
# to downgrade a hard failure into a warning (useful for lab / small test machines).
prechecks:
  # Management-plane minimum resources. Adjust to fit the deployment target.
  management_min_vcpus: 15               # minimum CPU cores
  management_min_memory_mb: 24576        # minimum RAM in MB (24G)
  management_min_root_free_gb: 350       # minimum free root space in GB (Harbor image storage and audit DB dominate)
  strict_resources: true                 # true: fail below thresholds; false: warn only and continue
  strict_ports: true                     # true: fail if a required port is busy; false: warn only (idempotent re-runs)
  ceph_node_min_data_disks: 3
  strict_data_disks: false               # true: fail on too few OSD disks; false: warn only
  # Kernel parameters are set by bootstrap-servers; during the M0 manual phase, only report
  enforce_kernel: false
  max_clock_offset_seconds: 1.0
  # Hostnames that must resolve (certificates / registry / repo); leave empty to skip
  required_hosts: []
  # Ports that must be free on the management node before deployment
  required_free_ports:
    - 80
    - 443
  # Set to true only after stage C1 brings up the internal repo, to check repo and Harbor reachability
  check_artifacts: false

# ---- consolidated from roles/system-init/defaults/main.yml ----
os_init_defaults:
  enabled: true

  # Base OS packages. In an offline site these come from the OS installation media,
  # not from the platform's internal artifact repo (which carries platform artifacts only).
  # podman is installed by the dedicated podman role (ADR-58), not here.
  packages:
    - python3
    - python3-pip
    - curl
    - wget
    - chrony

  chrony:
    enabled: true
    service: chronyd
    config_file: /etc/chrony.conf
    include_dir: /etc/chrony.d
    include_file: /etc/chrony.d/winter.conf
    # Empty keeps the distribution's default time sources. Non-empty appends an include file with
    # these servers; existing configuration is never overwritten or removed.
    servers: []

os_init: "{{ os_init_defaults | combine(os_init_overrides | default({}, true), recursive=True) }}"

# System initialization (ADR-17): base OS tools and chrony, extracted from bootstrap so it can be
# deployed alone. Deploy independently with: ./deploy.sh system-init -i inventory/multinode
# Write only differences; the role combines them with its own defaults.
os_init_overrides:

# ---- consolidated from roles/bootstrap/defaults/main.yml ----
bootstrap_defaults:
  enabled: true

  # Base OS packages and clock synchronization were extracted into roles/system-init,
  # which can run on its own. Configure them with os_init_overrides in group_vars/all.yml.

  # Kernel parameters previously only reported by roles/system-checks.
  # Off by default during M0 so bootstrap stays non-invasive; set bootstrap_overrides.enforce_kernel: true
  # (together with prechecks.enforce_kernel) to actually write them.
  enforce_kernel: false
  sysctl_file: /etc/sysctl.d/99-winter.conf
  sysctl:
    vm.overcommit_memory: 1
    vm.max_map_count: 262144
    net.bridge.bridge-nf-call-iptables: 1
    net.bridge.bridge-nf-call-ip6tables: 1

  # Optional data disk. Both destructive steps are opt-in: nothing is formatted or mounted by default.
  data_disk:
    device: ""
    mount_point: /data
    filesystem: xfs
    format_if_empty: false
    mount: false

bootstrap: "{{ bootstrap_defaults | combine(bootstrap_overrides | default({}, true), recursive=True) }}"

# Supported OS baselines (ADR-57). A host passes when its distribution +
# major version match any entry; `pretty_name_contains` optionally narrows it.
# Add Rocky/Alma/RHEL/Ubuntu here after a new baseline is approved — no role edit.
# Override at runtime with -e '{"prechecks_supported_os":[...]}' (top-level, so it
# does not wipe other prechecks.* settings).
prechecks_supported_os_defaults:
  - distribution: CentOS
    major_version: "9"
    pretty_name_contains: "CentOS Stream 9"
prechecks_supported_os: "{{ prechecks_supported_os_defaults }}"

# Base layer (roles/bootstrap): OS packages and the settings that prechecks only reports.
# Keep enforce_kernel in sync with prechecks.enforce_kernel above.
# Merge rule: write only differences here; the role combines them with its own defaults.
bootstrap_overrides:
  enforce_kernel: false
  data_disk:
    device: ""
    mount_point: /data
    filesystem: xfs
    format_if_empty: false
    mount: false

# Port used by the internal artifact repository Nginx site (roles/repo-nginx) and referenced by
# reconfigure's port-uniqueness check. Single source of truth; adjust here if 8082 is unavailable.
repo_nginx_listen_port: 8082

# ---- consolidated from roles/repo-nginx/defaults/main.yml ----
repo_nginx:
  # Artifact source (directory on the control machine)
  src: "{{ playbook_dir }}/artifacts/repo"
  # Publish directory (Nginx root)
  root: "{{ platform.data_dir }}/www/repo"
  listen_port: "{{ repo_nginx_listen_port }}"
  # Subnet allowed to access (change to the actual internal subnet on site)
  allow_cidr: "192.168.101.0/24"

# ---- etcd role (DCS for Patroni); all etcd settings live here, not under pg_cluster ----
# ADR-52: etcd is a standalone role (tag `etcd`), so its ports/dirs/binary are configured here.
# Override with -e '{"etcd_overrides":{"client_port":...}}' without touching PG settings.
etcd_defaults:
  client_port: 2379              # client read/write port
  peer_port: 2380                # Raft peer communication between members
  data_dir: /var/lib/etcd        # etcd data (mode 0700)
  bin_dir: /usr/local/bin        # etcd / etcdctl install directory
  tarball: etcd-v3.5.17-linux-amd64.tar.gz
  tarball_subdir: tarball        # subdir under platform.repo_base_url
  firewall_cidr: "192.168.101.0/24"   # subnet allowed to reach 2379/2380

etcd: "{{ etcd_defaults | combine(etcd_overrides | default({}, true), recursive=True) }}"

# ---- consolidated from roles/postgresql/defaults/main.yml ----
postgresql_defaults:
  # Target major version. Empty = auto-detect (an already-running instance takes priority)
  major: ""

  # Empty = auto-detect (show data_directory)
  data_dir: ""

  # Connections and database
  port: 5432
  listen_addresses: "127.0.0.1"
  db_name: winter
  db_user: winter

  # Whether to force-sync the password when the role already exists (default false: do not touch passwords others may have changed)
  force_password: false

  # Whether to tune memory parameters. Default false — tuning requires an instance restart, which interrupts other applications on the same machine (e.g. argus)
  tune: false

  # Effective when tune=true (rule of thumb for a 3GB single machine with co-located ceph; can be raised on a dedicated management node)
  shared_buffers: 256MB
  effective_cache_size: 1GB
  work_mem: 4MB
  maintenance_work_mem: 64MB
  max_connections: 100

  # Empty = postgresql-{{ major }}
  service_name: ""

  # Offline install: fetch the following RPMs from the internal repo (roles/repo-nginx), versions pinned to avoid on-site drift
  rpm_subdir: rpm/pgdg17
  # contrib is required: the Server migration creates the pgcrypto extension (0001_business.sql /
  # 0001_audit.sql) on both single-node and HA databases. Without it a clean HA cluster fails
  # to start the Server with 'extension pgcrypto is not available'.
  rpm_packages:
    - postgresql17-17.11-1PGDG.rhel9.8.x86_64.rpm
    - postgresql17-libs-17.11-1PGDG.rhel9.8.x86_64.rpm
    - postgresql17-server-17.11-1PGDG.rhel9.8.x86_64.rpm
    - postgresql17-contrib-17.11-1PGDG.rhel9.8.x86_64.rpm
  # contrib links against libperl.so.5.32, which the base OS already provides via perl-libs.
  # Do NOT pin a perl-libs RPM here: the OS perl package requires an exact perl-libs version
  # (e.g. 483), and installing a different one from the repo (e.g. 484) causes a dnf conflict.
  # The local repo still carries perl-libs as a fallback for minimal hosts that lack it.
  rpm_deps_subdir: rpm/base
  rpm_deps: []
  # Local staging directory
  rpm_stage_dir: /var/tmp/winter-pg17

postgresql: "{{ postgresql_defaults | combine(postgresql_overrides | default({}, true), recursive=True) }}"

# Database (role defaults are in roles/postgresql/defaults; only differences are written here)
# Note: you must use postgresql_overrides — writing postgresql: directly replaces the role's default dict wholesale,
#       causing uncovered keys (such as data_dir) to become undefined.
# Passwords are not in this file: see vault_pg_password in deploy/group_vars/all.yml (gitignored)
postgresql_overrides:
  # Prefer an already-running instance (leave empty = autodetect). A fresh machine will install PGDG 17 automatically
  major: ""
  db_name: winter
  db_user: winter
  # By default, do not change parameters of an existing instance: tuning requires a restart and would disrupt other services on the same host
  tune: false
  # Effective only when tune=true (empirical values for a 3GB single machine with ceph on the same host)
  shared_buffers: 256MB
  effective_cache_size: 1GB
  work_mem: 4MB
  maintenance_work_mem: 64MB
  max_connections: 100

# PostgreSQL high availability cluster (etcd + Patroni + HAProxy)
# All ports are configurable; the 5433 default avoids port 5432, already occupied by argus on .194
pg_cluster_defaults:
  scope: winter-pg          # Patroni cluster scope (DCS key prefix)
  # Single-node HA bootstrap (1-member etcd + single Patroni + HAProxy) is technically valid but
  # offers no fault tolerance. Opt in explicitly for a 1 -> 3 online growth path; keep false for
  # production so an undersized [etcd] is never deployed by accident.
  allow_single_node_bootstrap: false
  vip_iface_cidr: "192.168.101.0/24"   # subnet shared by pg_hba and all component firewalls

pg_cluster: "{{ pg_cluster_defaults | combine(pg_cluster_overrides | default({}, true), recursive=True) }}"

# ---- consolidated from roles/patroni/defaults/main.yml ----
patroni:
  # PG instance + REST ports and data dir (ADR-53: moved from pg_cluster.*)
  port: 5433                       # PG instance port (same on every node)
  rest_port: 8008                  # Patroni REST API
  data_dir: /var/lib/pgsql/17/ha   # separate from system /data
  # Target PG major version (must match the installed one)
  pg_major: "17"
  pg_bin: "/usr/pgsql-17/bin"
  # Accounts (passwords come from group_vars/all.yml; see the vault_* variables in the templates)
  superuser: postgres
  repl_user: replicator
  # Application database/account (keep consistent with the postgresql role)
  app_db: "{{ postgresql.db_name }}"
  app_user: "{{ postgresql.db_user }}"
  # Whether to disable the system-provided postgresql-<ver> service
  # - Standalone PG node: true (avoid competing with Patroni for the same instance)
  # - Another service already uses the system instance (e.g. argus on .194): false
  disable_standalone_pg: true
  # Source of pip wheels (internal repo)
  pip_subdir: pip

# ---- consolidated from roles/haproxy/defaults/main.yml ----
haproxy:
  rpm: haproxy-2.8.14-4.el9.x86_64.rpm
  rpm_subdir: rpm/base
  config: /etc/haproxy/haproxy.cfg
  listen_port: 5434       # applications connect here; always points to current primary
  check_interval: 2s
  check_fall: 3
  check_rise: 2

# PostgreSQL HA membership changes (ADR-17 / ADR-37). Nodes must already be in [etcd] in inventory/hosts.ini.
# The final etcd member count must stay odd and >= 3. Data is preserved unless purge_data is set.
pg_scale_defaults:
  nodes: []            # scale-out targets, e.g. [pg-d, pg-e]
  removed_nodes: []    # scale-in targets, e.g. [pg-e]
  purge_data: false
  data_dirs: []

# ADR-42: operation var files set *_overrides (partial dicts). extra-vars @file replaces whole
# dicts, so merge onto defaults to preserve keys not listed in an operation file.
pg_scale: "{{ pg_scale_defaults | combine(pg_scale_overrides | default({}, true), recursive=True) }}"

# Single-node PostgreSQL -> HA cluster data migration (ADR-40). The source is the system PG
# instance (postgresql.port); the target is the HA entry point (haproxy.listen_port).
# Both use the same database / role names, so only one database is moved.
pg_migrate_defaults:
  source_port: "{{ postgresql.port | default(5432) }}"
  target_port: "{{ haproxy.listen_port }}"
  database: "{{ postgresql.db_name | default('winter') }}"
  role: "{{ postgresql.db_user | default('winter') }}"
  # Marker written on the HA primary after a verified migration; makes the stage idempotent.
  marker_file: /etc/winter/pg-migrated
  # Staging area for the dump on the control host (deleted after a successful verified restore).
  dump_dir: /var/tmp/winter-pg-migrate
  # Per-table row-count comparison; checksums add a full-row hash for the critical tables.
  verify_checksums: true
  # Critical tables additionally verified by content hash (business + audit chain).
  critical_tables:
    - users
    - refresh_tokens
    - regions
    - azs
    - clusters
    - tasks
    - audit_intents
    - audit_results
  # Server services stopped during the maintenance window (no writes to the source).
  server_service: winter-server

# ADR-42: operations set pg_migrate_overrides (partial dict); merge to preserve defaults.
pg_migrate: "{{ pg_migrate_defaults | combine(pg_migrate_overrides | default({}, true), recursive=True) }}"

# ---- consolidated from roles/nginx/defaults/main.yml ----
nginx_defaults:
  # External domain (same as certificate CN); defaults to the platform domain
  server_name: "{{ platform.domain }}"

  http_port: 80
  https_port: "{{ platform.https_port }}"

  # Separate directory to avoid mixing with existing sites' (e.g. argus) /var/www
  doc_root: "{{ platform.data_dir }}/www"
  tls_dir: "{{ platform.data_dir }}/tls"
  conf_path: /etc/nginx/conf.d/winter.conf

  # Backend API (this platform's Server).
  # Note: 8080 may already be occupied by other services on the same host; default to 8081, keep it consistent when deploying the Server.
  api_upstream: "http://127.0.0.1:8081"

  # Self-signed certificate validity (days)
  tls_days: 825

nginx: "{{ nginx_defaults | combine(nginx_overrides | default({}, true), recursive=True) }}"

# Access layer (additive: does not modify nginx.conf or take over default_server)
# Same as above: use nginx_overrides and write only differences
nginx_overrides:
  server_name: "{{ platform.domain }}"
  # Port 8080 may be occupied by another service on the same host (argus here); the platform API uses 8081 by default
  api_upstream: "http://127.0.0.1:8081"
  tls_days: 825

# NOTE (ADR-53): Patroni's port/rest_port/data_dir moved to patroni.*; HAProxy's
# listen_port/check_* moved to haproxy.*. pg_cluster keeps only cluster-wide policy/network.

# Observability stack (ADR-18 / ADR-33): all components installed by default, single node, all listening only on localhost
# Ports, versions and retention may only be changed here; roles do not hardcode ports.
# Grafana is reverse-proxied via Nginx /grafana/ (ADR-09); port 3000 is not exposed directly.
victoriametrics_ports:
  victoriametrics: 8428
  vmalert: 8880
  victorialogs: 9428
  alertmanager: 9093
  grafana: 3000

victoriametrics_listen_addr: 127.0.0.1

# Single-node mode: bind and advertise both follow victoriametrics_listen_addr, so the existing
# localhost-only behaviour is preserved. The scale playbooks override these per host:
#   victoriametrics_bind_addr      -> 0.0.0.0              (accept internal traffic)
#   victoriametrics_advertise_addr -> the node internal IP (used by peers and reverse proxies)
victoriametrics_bind_addr: "{{ victoriametrics_listen_addr }}"

victoriametrics_advertise_addr: "{{ victoriametrics_listen_addr }}"
victoriametrics_health_retries: 30
victoriametrics_health_delay: 2

# Monitoring scale-out / scale-in (ADR-18 / ADR-33).
# Scope: stateless and HA layers only — Alertmanager gossip HA, Grafana replicas behind Nginx,
# and vmalert instances. VictoriaMetrics / VictoriaLogs use the single-node binaries with local
# storage and therefore stay one authoritative replica; set remote_write_url to aggregate
# additional replicas into a central VictoriaMetrics, but the playbooks never do that implicitly.
# Single-node default keeps the local Alertmanager; monitoring scale playbooks override this with
# the addresses of all Alertmanager replicas so alerts are de-duplicated by the gossip cluster.
victoriametrics_vmalert_notifiers:
  - "{{ victoriametrics_listen_addr }}"

victoriametrics_scale_defaults:
  nodes: []                  # scale-out targets, must already be listed in the [victoriametrics] group
  removed_nodes: []          # scale-in targets, kept in [victoriametrics] but excluded from all references
  purge_data: false          # never remove monitoring data unless explicitly requested
  data_dirs: []              # required and non-empty when purge_data is true
  cluster_port: 9094         # Alertmanager gossip port
  metrics_query_url: ""      # Grafana datasource target; empty resolves to the first active monitor node

victoriametrics_scale: "{{ victoriametrics_scale_defaults | combine(victoriametrics_scale_overrides | default({}, true), recursive=True) }}"

# Monitoring component configs (ADR-60): one dict per software role.
# Shared paths/runtime stay in victoriametrics.* below; each component owns its own binary/ports/args.
vmalert: "{{ vmalert_defaults | combine(vmalert_overrides | default({}, true), recursive=True) }}"
vmalert_defaults:
  enabled: true
  tarball: vmalert-linux-amd64-v1.156.0.tar.gz
  binary: vmalert-prod
  port: "{{ victoriametrics_ports.vmalert }}"
  listen_flag: -httpListenAddr
  health_path: /health
  args: "-datasource.url=http://{{ victoriametrics_metrics_url | default(victoriametrics_listen_addr) }}:{{ victoriametrics_ports.victoriametrics }} -rule={{ victoriametrics.config_dir }}/rules/*.yml -evaluationInterval=15s"

victorialogs: "{{ victorialogs_defaults | combine(victorialogs_overrides | default({}, true), recursive=True) }}"
victorialogs_defaults:
  enabled: true
  tarball: victoria-logs-linux-amd64-v1.54.0.tar.gz
  binary: victoria-logs-prod
  port: "{{ victoriametrics_ports.victorialogs }}"
  listen_flag: -httpListenAddr
  health_path: /health
  args: "-storageDataPath={{ victoriametrics.data_dir }}/victorialogs -retentionPeriod={{ victoriametrics.retention_days }}d"

alertmanager: "{{ alertmanager_defaults | combine(alertmanager_overrides | default({}, true), recursive=True) }}"
alertmanager_defaults:
  enabled: true
  tarball: alertmanager-0.35.0.linux-amd64.tar.gz
  binary: alertmanager
  port: "{{ victoriametrics_ports.alertmanager }}"
  listen_flag: --web.listen-address
  health_path: /-/healthy
  args: "--config.file={{ victoriametrics.config_dir }}/alertmanager.yml --storage.path={{ victoriametrics.data_dir }}/alertmanager"

grafana: "{{ grafana_defaults | combine(grafana_overrides | default({}, true), recursive=True) }}"
grafana_defaults:
  enabled: true
  mode: directory
  tarball: grafana-9.5.20.linux-amd64.tar.gz
  install_dir: /opt/winter/grafana
  port: "{{ victoriametrics_ports.grafana }}"
  health_path: /api/health


victoriametrics:
  enabled: true
  bin_dir: /usr/local/bin
  data_dir: /var/lib/winter/monitoring
  config_dir: /etc/winter/monitoring
  listen_addr: "{{ victoriametrics_listen_addr }}"
  run_user: winter-monitor          # run as non-root (similar constraint to ADR-19)
  retention_days: 30
  tarball_subdir: tarball
  # ADR-60 compatibility view: rebuild the old components dict from the four
  # standalone software dicts above. Code that iterates all components keeps working;
  # each component role reads its own <name>.* dict directly.
  components: "{{ {'victoriametrics': {'enabled': victoriametrics.enabled, 'tarball': victoriametrics.tarball | default('victoria-metrics-linux-amd64-v1.156.0.tar.gz'), 'binary': 'victoria-metrics-prod', 'port': victoriametrics_ports.victoriametrics, 'listen_flag': '-httpListenAddr', 'health_path': '/health', 'args': '-storageDataPath=' ~ victoriametrics.data_dir ~ '/victoriametrics -retentionPeriod=' ~ (victoriametrics.retention_days | string) ~ 'd'}, 'vmalert': vmalert, 'victorialogs': victorialogs, 'alertmanager': alertmanager, 'grafana': grafana} }}"
# Server (Go single binary + systemd); passwords and secrets live only in group_vars/all.yml, never here
winter_server:
  enabled: true
  bin_dir: /usr/local/bin
  config_dir: /etc/winter
  env_file: /etc/winter/server.env
  listen_addr: 127.0.0.1
  port: 8081                        # keep in sync with nginx.api_upstream
  app_env: prod
  admin_user: admin
  artifact: winter-server
  bin_subdir: bin

# Server replicas (ADR-34): the binary is stateless, sessions and tokens live in PostgreSQL.
# Single-node defaults keep localhost; the HA playbook overrides winter_server.listen_addr with
# each replica's internal address. database_host must point at the PG HA access point (HAProxy/VIP)
# once replicas are spread across nodes.
winter_server_ha_defaults:
  # DB endpoint mode: auto (detect HAProxy config on host, fall back to node count) | direct (local
  # 5432 system PG) | haproxy (winter_server_ha.database_host:5434). Most deployments leave this on auto.
  database_endpoint: auto
  database_host: 127.0.0.1
  audit_database_host: 127.0.0.1

winter_server_ha: "{{ winter_server_ha_defaults | combine(winter_server_ha_overrides | default({}, true), recursive=True) }}"

# Harbor (ADR-16).
# mode: builtin  — MVP single node. Harbor's own bundled PostgreSQL, Redis and local data volume.
#                 No external PG / Redis / NFS required. This is the default and matches the
#                 ADR-16 MVP decision (Harbor's bundled PG or a standalone instance;
#                 multi-replica + external dependencies are V1).
# mode: external — V1 HA. Multiple replicas share an external PostgreSQL (the platform PG HA
#                 entry point), an external Redis and an NFS share. All three are site
#                 prerequisites; this framework never deploys a Redis or NFS server on its own.
harbor:
  enabled: false
  mode: builtin                           # builtin | external
  version: v2.11.0
  tarball: harbor-offline-installer-v2.11.0.tgz
  tarball_subdir: tarball
  install_dir: /opt/winter/harbor
  data_dir: /var/lib/winter/harbor
  hostname: "{{ platform.registry_host }}"
  bind_addr: 127.0.0.1
  http_port: 80
  # Local data volume used in builtin mode (bundled PG/Redis data lives here too).
  local_volume: /var/lib/winter/harbor/data
  database:
    host: ""                              # external PostgreSQL address, required in external mode
    port: "{{ haproxy.listen_port }}"
    name: registry
    user: harbor
  redis:
    host: ""                              # external Redis address, required in external mode
    port: 6379
    db: 0
  storage:
    nfs_server: ""                        # NFS server address, required in external mode
    nfs_path: ""                          # exported share path, required in external mode
    mount_point: /var/lib/winter/harbor/shared
    options: "vers=4.1,rw"
  health_path: /api/v2.0/health

# ---- consolidated from roles/harbor/defaults/main.yml ----

# ---- consolidated from roles/keepalived/defaults/main.yml ----
keepalived:
  config_path: /etc/keepalived/keepalived.conf
  check_script: /etc/keepalived/check_nginx.sh
  lvs_check_script: /etc/keepalived/check_lvs.sh
  service: keepalived

# High availability (ADR-16 / ADR-35): stateless Server replicas and Harbor replicas sit behind
# Nginx, with Keepalived providing a floating VIP on the [keepalived] nodes. Single-node inventories keep
# everything on etcd and leave ha.enabled=false.
ha_defaults:
  enabled: false
  interface: eth0                         # NIC that carries the VIP
  vip: ""                                 # single VIP (active-standby)
  # Multiple VIPs enable active-active Directors: each [keepalived] node owns one VIP as MASTER and
  # backs up the rest. Publish every VIP as an A record for the platform domain so clients
  # spread across Directors. Empty falls back to the single ha.vip.
  vips: []                                # e.g. [10.0.0.100, 10.0.0.101]
  virtual_router_id: 51                   # base VRRP ID; each extra VIP increments it
  priority: 100                           # override per host for master/backup (e.g. 100 / 90)
  advertise_interval: 1
  preempt: true
  auth_type: PASS
  nginx_check_interval: 2                 # health-check script interval in seconds
  peer_addresses: []                      # other [keepalived] addresses; computed by the playbook when empty
  # LVS/DR four-layer load balancing (Keepalived native). Without it the VIP only provides
  # failover and every connection lands on the single node holding the VIP.
  lvs:
    enabled: false                        # requires at least two [nginx]
    scheduler: rr                         # rr / wrr / lc / wlc
    persistence_timeout: 0                # seconds, 0 = no session affinity
    health_interval: 6
    connect_timeout: 3
    real_server_port: "{{ platform.https_port }}"
    real_servers: []                      # computed by application-ha from [nginx]

# ADR-42: operations set ha_overrides (partial dict); extra-vars @file replaces whole dicts, so
# merging is required or ha.lvs / ha.virtual_router_id disappear during an operation run.
ha: "{{ ha_defaults | combine(ha_overrides | default({}, true), recursive=True) }}"

# ---- consolidated from roles/realserver/defaults/main.yml ----
lvs_realserver:
  sysctl_path: /etc/sysctl.d/99-winter-lvs.conf
  helper: /usr/local/bin/winter-lvs-vip.sh
  unit: winter-lvs-vip.service
  vip: "{{ ha.vip }}"

# DNS (BIND 9): authoritative internal DNS for the platform domain (ADR-16 / ADR-17).
# Publishes one A record per active-active Director VIP so DNS round-robin spreads clients
# across Directors; the record set is derived from named.vips -> ha.vips -> ha.vip.
# Deploy independently with: ./deploy.sh named -i inventory/multinode
named_defaults:
  enabled: false
  # package = dnf from host repos; repo = offline RPMs from the internal static repo
  install_method: package
  packages: [bind, bind-utils]
  rpm_subdir: rpm/bind
  rpm_dir: "{{ playbook_dir }}/artifacts/repo/rpm/bind"
  rpm_files: []                        # required and non-empty when install_method=repo
  service: named
  config_file: /etc/named.conf
  zone_dir: /var/named
  listen_port: 53
  listen_addr: any                     # BIND listen-on address match list
  forwarders: []                       # upstream resolvers for external names
  recursion: false
  dnssec: false
  domain: "{{ platform.domain }}"
  ttl: 60
  admin_mailbox: hostmaster
  vips: []                             # empty falls back to ha.vips, then ha.vip
  master_addresses: []                 # empty derives from [dns_masters] or [named] minus [dns_slaves]
  slave_addresses: []                  # empty derives from [dns_slaves]
  tsig_key_name: winter-dns            # secret is vault_dns_tsig_secret in group_vars/all.yml
  allow_query_cidrs: []                # empty = any
  allow_transfer_cidrs: []             # empty = TSIG key only on the master
  manage_firewall: true                # open the DNS port with firewalld; false for an external firewall
  manage_systemd_resolved: true         # disable the systemd-resolved stub listener to free the DNS port
  check_interval: 60                   # local resolution check retry window (seconds)

# ADR-42: operation files set named_overrides (partial dict); extra-vars @file replaces whole dicts,
# so merge onto defaults to preserve lazy keys such as domain ({{ platform.domain }}).
named: "{{ named_defaults | combine(named_overrides | default({}, true), recursive=True) }}"

# ---- consolidated from roles/winter_agent/defaults/main.yml ----
winter_agent_defaults:
  enabled: true

  # Node identity reported in HELLO; must match the CN/SPIFFE URI in the certificate.
  node_id: "{{ inventory_hostname }}"

  # Server gRPC endpoint. The deployment plan specifies outbound 443 on managed nodes.
  # Nginx must add grpc_pass for the Agent service before this endpoint becomes usable.
  server_address: "winter.local:443"

  bin_dir: /usr/local/bin
  config_dir: /etc/winter/winter_agent
  env_file: /etc/winter/winter_agent/winter_agent.env
  log_dir: /var/log/winter/winter_agent
  run_user: winter-agent

  artifact: winter-agent
  bin_subdir: bin

  # Protocol runtime parameters (Agent-Server communication protocol v1).
  heartbeat_interval_s: 10
  task_window: 4
  max_message_bytes: 1048576

  cert:
    dir: /etc/winter/winter_agent/certs
    key: winter_agent.key
    cert: winter_agent.crt
    ca: ca.crt
    csr: winter_agent.csr
    key_bits: 2048
    # Path on the CONTROL machine of the CA that signs Agent certificates.
    # Private keys are generated on the node and never leave it (ADR-28).
    ca_source: ""
    # local_csr: generate key + CSR on the node, leave enrollment to the Server API or an operator.
    # preissued: copy an already-issued key/cert from the control machine (offline/test path).
    enrollment_mode: local_csr
    preissued_key_source: ""
    preissued_cert_source: ""

  sudo:
    enabled: true
    file: /etc/sudoers.d/winter-agent
    # Explicit absolute paths only; no ALL, no interpreters (ADR-19).
    # Default set is read-only; extend for managed capability after review.
    rules:
      - "winter-agent ALL=(root) NOPASSWD: /usr/bin/ceph -s, /usr/bin/ceph status, /usr/bin/ceph health"

  # Scale-in safety: never remove platform data unless explicitly requested.
  scale_in:
    purge_data: false
    data_dirs: []
    remove_user: false
    revoke_cert: false

winter_agent: "{{ winter_agent_defaults | combine(winter_agent_overrides | default({}, true), recursive=True) }}"

  # packages: [python3, python3-pip, curl, wget, chrony]  # podman has its own role (ADR-58)
  # chrony:
  #   enabled: true
  #   servers: []              # e.g. [time.corp.local, 10.0.0.1] to add explicit NTP sources

# Managed-node Agent (ADR-35 / ADR-19 / ADR-28), driven by scale-out and scale-in.
# Prerequisites before scale-out: the winter-agent binary in the internal repo, a CA certificate
# on the control machine, and Nginx grpc_pass on the documented outbound port 443.
# TODO: set cert.ca_source to the real signing CA once the Go Agent enrollment work lands.
winter_agent_overrides:
  enabled: true
  server_address: "winter.local:443"
  cert:
    ca_source: ""
  sudo:
    rules:
      - "winter-agent ALL=(root) NOPASSWD: /usr/bin/ceph -s, /usr/bin/ceph status, /usr/bin/ceph health"
  scale_in:
    purge_data: false
    data_dirs: []
    remove_user: false
    revoke_cert: false

# Version upgrade (ADR-17): versions are pinned in group_vars and in artifacts/repo/SHA256SUMS.txt.
# Pass target_version at runtime with -e; empty by default so an upgrade cannot be run accidentally.
upgrade:
  target_version: ""
  require_checksums: true

# ---- podman role (container runtime, ADR-11 / ADR-58) ----
# podman is a standalone role, not a package inside os_init.packages.
podman_defaults:
  enabled: true
  package: podman
  disablerepo: []        # e.g. ['pgdg*'] when third-party repos are unreachable
podman: "{{ podman_defaults | combine(podman_overrides | default({}, true), recursive=True) }}"

# ---- consolidated from roles/uninstall/defaults/main.yml ----
uninstall_defaults:
  enabled: true

  # Destructive options are off by default. purge_data requires an explicit non-empty data_dirs list.
  purge_data: false
  data_dirs: []
  remove_users: false

  services: []
  unit_paths: []
  file_paths: []
  users: []

  firewall:
    remove_rule: false
    cidr: ""
    port: 0

uninstall: "{{ uninstall_defaults | combine(uninstall_overrides | default({}, true), recursive=True) }}"

# Platform uninstall (ADR-17 destroy stage). Review these paths if any deployment path was customized.
# purge_data is off by default; an explicit data_dirs list is required to remove anything irreversible.
uninstall_overrides:
  services:
    - winter-server
    - winter-victoriametrics
    - winter-vmalert
    - winter-victorialogs
    - winter-alertmanager
    - winter-grafana
  unit_paths:
    - /etc/systemd/system/winter-server.service
    - /etc/systemd/system/winter-victoriametrics.service
    - /etc/systemd/system/winter-vmalert.service
    - /etc/systemd/system/winter-victorialogs.service
    - /etc/systemd/system/winter-alertmanager.service
    - /etc/systemd/system/winter-grafana.service
  file_paths:
    - /etc/nginx/conf.d/winter.conf
    - /etc/nginx/conf.d/winter-repo.conf
    - "{{ winter_server.env_file }}"
    - "{{ winter_server.config_dir }}"
    - "{{ winter_server.bin_dir }}/{{ winter_server.artifact }}"
    - "/etc/winter/monitoring"
    - /usr/local/bin/victoria-metrics-prod
    - /usr/local/bin/vmalert-prod
    - /usr/local/bin/victoria-logs-prod
    - /usr/local/bin/alertmanager
    - /opt/winter/grafana
    - /var/tmp/winter-server
    - /var/tmp/winter-observability
    - "{{ platform.data_dir }}/www"
    - "{{ platform.data_dir }}/tls"
  users:
    - winter-server
    - winter-monitor
  firewall:
    remove_rule: true
    cidr: "192.168.101.0/24"
    port: 8082
  purge_data: false
  data_dirs: []
  remove_users: false

# ---- consolidated from roles/winter-server/defaults/main.yml ----

# ---- Secrets (consolidated from group_vars/all.yml, ADR-45) ----
# Fill real values on the control machine; this file is gitignored.
vault_pg_password: "CHANGE_ME_PG_PASSWORD"

vault_jwt_secret: "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"

vault_admin_password: "CHANGE_ME_ADMIN_PASSWORD"

vault_grafana_admin_password: "CHANGE_ME_GRAFANA_PASSWORD"

vault_keepalived_auth_pass: "VRRPPASS"

vault_harbor_db_password: "CHANGE_ME_HARBOR_DB_PASSWORD"

vault_harbor_redis_password: "CHANGE_ME_HARBOR_REDIS_PASSWORD"

vault_harbor_admin_password: "CHANGE_ME_HARBOR_ADMIN_PASSWORD"

vault_dns_tsig_secret: "CHANGE_ME_BASE64_TSIG_SECRET"
