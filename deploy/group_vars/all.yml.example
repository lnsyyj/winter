# Site configuration template (ADR-17 / ADR-45 / ADR-63).
#
# Copy to group_vars/all.yml and fill in the vault_* values. group_vars/all.yml is
# gitignored — never commit real secrets. This template is committed.
#
# Layering (ADR-63):
#   - Per-role DEFAULTS live in roles/<role>/defaults/main.yml (committed, do not edit for a site).
#   - Site OVERRIDES go in group_vars/all.yml as <name>_overrides (partial dicts, merged by ADR-42)
#     or at runtime via -e '{"<name>_overrides":{...}}'.
#   - Only site-wide globals, precheck thresholds and secrets stay in this file.
#
# Site override examples (append as needed):
#   postgresql_overrides: {port: 5433}
#   keepalived_overrides: {vip: 192.168.101.250, interface: ens34}
#   winter_server_ha_overrides: {database_host: 192.168.101.198, database_endpoint: haproxy}


site:
  domain: winter.local                  # external domain (certificates + access entry)
  https_port: 443                       # the only externally open port
  data_dir: /var/lib/winter             # shared data root (excluded from upgrades)
  version: unspecified                  # deployment manifest version (verify records it)



# Precheck thresholds (aligned with the resource estimates in deployment plan §1; Harbor and the victoriametrics stack dominate)
# All thresholds below are configurable; every check is mandatory and any failure aborts
# the run (ADR-64). Tune thresholds for the target host, but there is no warn-only mode.

prechecks:
  # Management-plane minimum resources. Adjust to fit the deployment target.
  management_min_vcpus: 15               # minimum CPU cores
  management_min_memory_mb: 24576        # minimum RAM in MB (24G)
  management_min_root_free_gb: 350       # minimum free root space in GB (Harbor image storage and audit DB dominate)
  # ADR-64: all checks are mandatory. No strict_*/warn-only switches — every check
  # asserts and any failure aborts the run (any_errors_fatal on every play).
  ceph_node_min_data_disks: 3            # extra data disks expected (production baseline)
  max_clock_offset_seconds: 1.0
  # Kernel parameters verified on every host; thresholds configurable here.
  expected_vm_overcommit_memory: 1
  expected_vm_max_map_count: 262144
  # Hostnames that must resolve (certificates / registry / repo); must be non-empty (ADR-64)
  required_hosts:
    - "{{ site.domain }}"
  # Ports that must be free on the management node before deployment
  required_free_ports:
    - 80
    - 443
  # Artifact endpoints checked unconditionally (ADR-64). Remove an entry only if
  # that component is truly not part of the deployment.
  artifact_targets:
    repo: "{{ repo_nginx.base_url }}repodata/repomd.xml"
    registry: "https://{{ harbor.hostname }}/v2/"

# Supported OS baselines (ADR-57). A host passes when its distribution +
# major version match any entry; `pretty_name_contains` optionally narrows it.
# Add Rocky/Alma/RHEL/Ubuntu here after a new baseline is approved — no role edit.
# Override at runtime with -e '{"prechecks_supported_os":[...]}' (top-level, so it
# does not wipe other prechecks.* settings).

prechecks_supported_os_defaults:
  - distribution: CentOS
    major_version: "9"
    pretty_name_contains: "CentOS Stream 9"

prechecks_supported_os: "{{ prechecks_supported_os_defaults }}"

# Base layer (roles/bootstrap): OS packages and the settings that prechecks only reports.
# Kernel parameters are enforced by bootstrap and verified by prechecks (ADR-64).
# Merge rule: write only differences here; the role combines them with its own defaults.

vault_pg_password: "CHANGE_ME_PG_PASSWORD"

vault_jwt_secret: "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"

vault_admin_password: "CHANGE_ME_ADMIN_PASSWORD"

vault_grafana_admin_password: "CHANGE_ME_GRAFANA_PASSWORD"

vault_keepalived_auth_pass: "VRRPPASS"

vault_harbor_db_password: "CHANGE_ME_HARBOR_DB_PASSWORD"

vault_harbor_redis_password: "CHANGE_ME_HARBOR_REDIS_PASSWORD"

vault_harbor_admin_password: "CHANGE_ME_HARBOR_ADMIN_PASSWORD"

vault_dns_tsig_secret: "CHANGE_ME_BASE64_TSIG_SECRET"
